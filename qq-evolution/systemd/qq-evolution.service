[Unit]
Description=QQ autonomous evolution supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/qq-evolution/control
Environment=PYTHONPATH=/home/admin/qq-evolution/control
Environment=QQ_EVOLUTION_STATE=/home/admin/qq-evolution-state/state.json
Environment=QQ_EVOLUTION_LOCK=/home/admin/qq-evolution-state/job.lock
ExecStart=/usr/bin/python3 /home/admin/qq-evolution/control/supervisor.py
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/admin/qq-evolution-state /home/admin/qq-evolution-runtime /home/admin/qq-evolution/control /home/admin/.codex /home/admin/.cache
MemoryMax=700M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
