[Unit]
Description=Combined Codex and QQ health report to QQ Space
After=network-online.target qq-evolution.service
Wants=network-online.target

[Service]
Type=oneshot
User=admin
WorkingDirectory=/home/admin/qq-evolution/control
ExecStart=/usr/bin/python3 /home/admin/qq-evolution/control/status_report.py
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/admin/qq-evolution-state

