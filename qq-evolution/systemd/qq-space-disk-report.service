[Unit]
Description=Publish QQ server capacity to QQ Space
After=network-online.target qq-hermes-bridge.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
WorkingDirectory=/home/hermes
Environment=HOME=/home/hermes
ExecStart=/home/hermes/.hermes/tools/node-26.12.1-linux-x64/bin/node /home/hermes/qq-space-disk-report.mjs
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

