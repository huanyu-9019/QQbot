[Unit]
Description=Publish sanitized QQ and Codex status for the admin panel
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/home/admin/qq-evolution/development/qq-evolution
Environment=QQ_EVOLUTION_STATE_DIR=/home/admin/qq-evolution-state
Environment=QQ_EVOLUTION_STATE=/home/admin/qq-evolution-state/state.json
Environment=QQ_MONITOR_HEALTH=/home/admin/qq-evolution-state/monitor-health.json
ExecStart=/usr/bin/python3 /home/admin/qq-evolution/development/qq-evolution/publish_admin_status.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/admin/qq-evolution-state

