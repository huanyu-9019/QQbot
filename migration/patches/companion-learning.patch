+"""Redact copies of expression-learning material before a cloud request."""
+
+import re
+
+_PATTERNS = (
+    (r"-----BEGIN [^-]*PRIVATE KEY-----[\s\S]*?-----END [^-]*PRIVATE KEY-----", "[REDACTED_SECRET]"),
+    (r"\bsk-[A-Za-z0-9_-]{12,}", "[REDACTED_SECRET]"),
+    (r"(?i)\b(?:authorization)\s*[:=]\s*(?:bearer\s+)?[^\s,;，；]+", "[REDACTED_SECRET]"),
+    (r"(?i)\b(?:api[_-]?key|token|secret|password)\s*[:=]\s*[^\s,;，；]+", "[REDACTED_SECRET]"),
+    (r"(?<!\d)1[3-9]\d{9}(?!\d)", "[REDACTED_PHONE]"),
+    (r"[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", "[REDACTED_EMAIL]"),
+)
+
+
+def redact_material(value):
+    """Keep structure and opaque evidence handles; never mutate stored samples."""
+    if isinstance(value, str):
+        for pattern, replacement in _PATTERNS:
+            value = re.sub(pattern, replacement, value)
+        return value
+    if isinstance(value, dict):
+        return {key: redact_material(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [redact_material(item) for item in value]
+    return value
