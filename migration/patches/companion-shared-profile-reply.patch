@@ -0,0 +1,71 @@
+"""A person's own public statements may follow them into their private chat.
+
+This is a read projection over governed group memory, not a copied fact store.
+Private sources never enter the query; other members, bots, roles and groups'
+audiences cannot use this bridge. Each source is checked again on every read.
+"""
+
+import json
+
+from companion_v2.execution.models import TaskContext, TaskError, encode
+from companion_v2.foundation.refs import ScopeKind
+from .access import owner_key
+
+
+INSTRUCTION = (
+    "这是同一认证账号在群聊和本人私聊共用档案中的公开陈述。它们是对方曾说过的话，"
+    "不自动成为已核实事实；提及其他人时仍属于其他人，不转成当前用户的偏好。"
+    "结合称呼、明确偏好和共同经历自然接话，尊重新说法、时间和不确定性。"
+    "不用因为换成私聊就假装第一次认识；不要播报账号、内部编号或群成员信息。"
+    "私人记忆仍只用于本人私聊，不向任何群聊披露。未显示不代表从未说过。"
+)
+
+
+def statements(acquaintance, messages, context, *, speaker_id=None, limit=8):
+    acquaintance.check(context)
+    if not acquaintance.available(context):
+        return []
+    if context.scope.kind is not ScopeKind.PRIVATE:
+        return []
+    native = context.actor.principal.native_account_id
+    if (context.audience.recipients != (context.actor.subject,)
+            or speaker_id is not None and str(speaker_id) != native):
+        raise TaskError("shared_profile_owner_required", "only this person's private audience may recall their group statements")
+    # Apply author and route filters before the bounded scan. The original
+    # operation is only a locator; full original-source governance is checked
+    # by GroupMemory._read_row below, including withdrawal, binding and role.
+    rows = messages.runtime.read_all("""SELECT v.*, o.context_json AS original_context
+        FROM memory_views v JOIN memory_operations o
+          ON json_extract(o.result_json, '$.memory_id') = v.view_id
+         AND json_extract(o.result_json, '$.revision') = v.revision
+        WHERE v.kind = 'group.public.statement.v1' AND v.state = 'active'
+          AND o.namespace = 'memory.group' AND o.state = 'saved'
+          AND json_extract(v.document_json, '$.author') = ?
+          AND json_extract(o.context_json, '$.audience.scope.installation_id') = ?
+          AND json_extract(o.context_json, '$.audience.scope.platform') = ?
+          AND json_extract(o.context_json, '$.audience.scope.bot_id') = ?
+          AND json_extract(o.context_json, '$.audience.scope.account_id') = ?
+          AND json_extract(o.context_json, '$.role_binding.role.subject_id') = ?
+        ORDER BY v.updated_at DESC, v.view_id DESC LIMIT 64""",
+        (context.actor.subject.subject_id, context.scope.installation_id, context.scope.platform,
+         context.scope.bot_id, context.scope.account_id, context.role_binding.role.subject_id))
+    items, seen, used = [], set(), 0
+    for row in rows:
+        original = TaskContext.restore(json.loads(row['original_context']))
+        if owner_key(original) != owner_key(context) or original.actor.principal.host_id != context.actor.principal.host_id:
+            continue
+        try:
+            item, _ = messages.group_memory._read_row(row, at=messages.tasks.now())
+        except TaskError:
+            continue
+        if item['memory_id'] in seen or item['speaker_id'] != native:
+            continue
+        size = len(encode(item).encode('utf-8'))
+        if used + size > 8192:
+            continue
+        seen.add(item['memory_id'])
+        used += size
+        items.append(item)
+        if len(items) >= min(8, max(1, limit)):
+            break
+    return items
